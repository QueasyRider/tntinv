# Give every business its own database and unique secrets. Never reuse production values.
DATABASE_URL=

# Required in production. Generate exactly 32 random bytes and base64-encode them.
APP_ENCRYPTION_KEY=

# Final HTTPS address, without a trailing slash. Local development may use http://localhost:3000.
PUBLIC_APP_URL=

# Initial private login. The administrator can replace these credentials inside Settings later.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Use at least 32 random characters. Changing this value signs out every browser.
SESSION_SECRET=
