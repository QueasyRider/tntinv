# Optional in local development: the app creates .data/master.key automatically.
# Required for stable encryption across production instances. Generate 32 random bytes and base64-encode them.
DATABASE_URL=
APP_ENCRYPTION_KEY=
PUBLIC_APP_URL=https://inventory.twistedandthrifted.com

# Required private login settings. Never prefix these with NEXT_PUBLIC_.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Use at least 32 random characters. Changing it signs out every browser.
SESSION_SECRET=
